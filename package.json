{
	"name": "svnbox",
	"version": "0.1.0",
	"description": "仓盒 · 面向 macOS 的多工作副本 SVN 客户端",
	"author": "svnbox",
	"license": "MIT",
	"private": true,
	"main": "out/main/index.js",
	"scripts": {
		"dev": "npm run svn:build && electron-vite dev",
		"start": "npm run svn:build && electron-vite preview",
		"build": "npm run typecheck && electron-vite build",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"pretest": "npm run svn:build",
		"test": "vitest run",
		"test:e2e": "npm run svn:build && npm run build && node scripts/e2e.mjs",
		"format": "prettier --write src tests scripts electron.vite.config.ts",
		"package:mac": "npm run svn:build && npm run icons:build && npm run build && electron-builder --mac dmg zip --arm64",
		"package:dir": "npm run svn:build && npm run icons:build && npm run build && electron-builder --mac dir --arm64",
		"svn:build": "node scripts/build-svn-runtime.mjs",
		"icons:build": "node scripts/build-icons.mjs"
	},
	"dependencies": {
		"@radix-ui/react-context-menu": "2.4.1",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-dropdown-menu": "2.2.1",
		"@radix-ui/react-popover": "1.3.1",
		"@radix-ui/react-select": "2.4.1",
		"@radix-ui/react-slot": "1.5.0",
		"@tanstack/react-virtual": "3.14.22",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"fast-xml-parser": "5.11.2",
		"lucide-react": "0.577.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"electron": "45.0.0",
		"electron-builder": "26.18.0",
		"electron-vite": "6.0.0",
		"playwright": "1.64.1",
		"prettier": "3.9.10",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"build": {
		"appId": "app.svnbox.desktop",
		"productName": "仓盒",
		"artifactName": "svnbox-${version}-${arch}.${ext}",
		"directories": {
			"output": "release"
		},
		"files": [
			"out/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "resources/svn/darwin-arm64",
				"to": "svn",
				"filter": [
					"**/*"
				]
			}
		],
		"mac": {
			"category": "public.app-category.developer-tools",
			"target": [
				"dmg",
				"zip"
			],
			"hardenedRuntime": true,
			"identity": null,
			"minimumSystemVersion": "13.0",
			"icon": "resources/svnbox.icon"
		},
		"dmg": {
			"title": "安装仓盒 svnbox",
			"icon": "resources/icon.icns"
		}
	}
}
